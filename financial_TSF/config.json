{
    "data": {
        "concatenated_csv": "data/concatenated/",
        "number_of_tickers": 4,
        "start_date": "2015-01-01",
        "end_date": "2023-12-31",
        "use_cached_processed_data": false,
        "processed_csv": "data/processed/"
    },
    "model": {
        "modelType": "LinearRegression"
    },
    "features": {
        "featureConfigPath": "financial_TSF/features/feature_config.json",
        "complexity_levels": [
            20
        ]
    },
    "pipeline": {
        "steps": [
            "DataLoadingStep",
            "FeatureStep",
            "SplittingStep",
            "NormalizingStep",
            "TrainingStep",
            "EvaluationStep",
            "SavingStep"
        ],
        "use_hyperparameter_tuning": true,
        "use_scaling": true,
        "use_winsorizing": true
    },
    "results": {
        "resultsPath": "results/thesis_w_params/"
    },
    "settings": {
        "forecast_horizon": [
            6,
            12,
            24,
            48
        ]
    }
}