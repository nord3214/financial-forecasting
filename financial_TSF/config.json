{
    "data": {
        "concatenated_csv": "data/concatenated/",
        "number_of_tickers": 1,
        "start_date": "2015-01-01",
        "end_date": "2018-12-31",
        "use_cached_processed_data": false,
        "processed_csv": "data/processed/"
    },
    "model": {
        "modelType": "PatchTST"
    },
    "features": {
        "featureConfigPath": "financial_TSF/features/feature_config.json",
        "complexity_levels": [
            10,
            20,
            30
        ]
    },
    "pipeline": {
        "steps": [
            "DataLoadingStep",
            "FeatureStep",
            "SplittingStep",
            "NormalizingStep",
            "TrainingStep",
            "EvaluationStep",
            "SavingStep"
        ],
        "use_hyperparameter_tuning": false,
        "use_scaling": true,
        "use_winsorizing": true
    },
    "results": {
        "resultsPath": "resultsTraining/"
    },
    "settings": {
        "forecast_horizon": [
            24
        ]
    }
}